+func TestVolumeMountStatuses(t *testing.T) {
+	disabled, enabled := v1.RecursiveReadOnlyDisabled, v1.RecursiveReadOnlyEnabled
+	tests := []struct {
+		name        string
+		mount       v1.VolumeMount
+		supportsRRO bool
+		want        v1.VolumeMountStatus
+	}{
+		{
+			name:  "read-write mount has no recursive read-only mode",
+			mount: v1.VolumeMount{Name: "data", MountPath: "/data"},
+			want:  v1.VolumeMountStatus{Name: "data", MountPath: "/data"},
+		},
+		{
+			name:  "read-only mount without a mode is disabled",
+			mount: v1.VolumeMount{Name: "data", MountPath: "/data", ReadOnly: true},
+			want:  v1.VolumeMountStatus{Name: "data", MountPath: "/data", ReadOnly: true, RecursiveReadOnly: &disabled},
+		},
+		{
+			name:        "IfPossible is enabled when the runtime supports it",
+			mount:       v1.VolumeMount{Name: "data", MountPath: "/data", ReadOnly: true, RecursiveReadOnly: ptr.To(v1.RecursiveReadOnlyIfPossible)},
+			supportsRRO: true,
+			want:        v1.VolumeMountStatus{Name: "data", MountPath: "/data", ReadOnly: true, RecursiveReadOnly: &enabled},
+		},
+		{
+			name:  "IfPossible is disabled when the runtime does not support it",
+			mount: v1.VolumeMount{Name: "data", MountPath: "/data", ReadOnly: true, RecursiveReadOnly: ptr.To(v1.RecursiveReadOnlyIfPossible)},
+			want:  v1.VolumeMountStatus{Name: "data", MountPath: "/data", ReadOnly: true, RecursiveReadOnly: &disabled},
+		},
+		{
+			name:  "Enabled without runtime support is an error and reported as disabled",
+			mount: v1.VolumeMount{Name: "data", MountPath: "/data", ReadOnly: true, RecursiveReadOnly: ptr.To(v1.RecursiveReadOnlyEnabled)},
+			want:  v1.VolumeMountStatus{Name: "data", MountPath: "/data", ReadOnly: true, RecursiveReadOnly: &disabled},
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			container := v1.Container{VolumeMounts: []v1.VolumeMount{tc.mount}}
+			got := volumeMountStatuses(klog.Background(), container, tc.supportsRRO)
+			assert.Equal(t, []v1.VolumeMountStatus{tc.want}, got)
+		})
+	}
+
+	t.Run("container without mounts has no mount statuses", func(t *testing.T) {
+		assert.Nil(t, volumeMountStatuses(klog.Background(), v1.Container{}, true))
+	})
+}
+
+func TestImageVolumeSpec(t *testing.T) {
+	cs := &kubecontainer.Status{Mounts: []kubecontainer.Mount{
+		{Name: "config"},
+		{Name: "other-image", Image: &runtimeapi.ImageSpec{Image: "sha256:other"}},
+		{Name: "image", Image: &runtimeapi.ImageSpec{Image: "sha256:image"}},
+	}}
+
+	assert.Equal(t, "sha256:image", imageVolumeSpec(cs, "image").Image)
+	assert.Empty(t, imageVolumeSpec(cs, "config").Image, "mount without an image")
+	assert.Empty(t, imageVolumeSpec(cs, "missing").Image, "mount that the runtime does not report")
+}
